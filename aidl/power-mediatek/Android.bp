cc_library_shared {
    name: "android.hardware.power-service-mediatek",
    vendor: true,
    compile_multilib: "64",
    vintf_fragments: ["power-mtk.xml"],
    cflags: select(soong_config_variable("mediatek_power", "double_tap_to_wake_node"), {
        any @ flag_val: ["-DTAP_TO_WAKE_NODE=\"" + flag_val + "\""],
        default: [],
    }) + select(soong_config_variable("mediatek_power", "powerhal_ext"), {
        any @ flag_val: ["-DMODE_EXT"],
        default: [],
    }),
    srcs: ["Power.cpp"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.power-V2-ndk",
    ],
    whole_static_libs: select(soong_config_variable("mediatek_power", "powerhal_ext"), {
        any @ flag_val: [flag_val],
        default: [],
    }),
}
