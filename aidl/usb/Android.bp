cc_binary {
    name: "android.hardware.usb-service.mediatek",
    relative_install_path: "hw",
    init_rc: ["android.hardware.usb-service.mediatek.rc"],
    vintf_fragments: ["android.hardware.usb-service.mediatek.xml"],
    vendor: true,
    cflags: select(soong_config_variable("android_hardware_mediatek_usb", "audio_accessory_supported"), {
        true: ["-DUSB_AUDIO_ACCESSORY_SUPPORTED"],
        default: [],
    }),
    srcs: [
        "service.cpp",
        "Usb.cpp",
    ],
    shared_libs: [
        "android.hardware.usb-V3-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
    ],
}
